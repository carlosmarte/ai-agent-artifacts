{
  "name": "@skills/playwright-ui-locator",
  "version": "0.1.0",
  "private": true,
  "description": "Auto-heal Playwright tests after DOM/class changes by fingerprinting old elements and matching them in the new DOM.",
  "type": "module",
  "bin": {
    "pw-ui-locator": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "watch": "tsc -p tsconfig.json --watch",
    "test": "node --test --experimental-strip-types src/**/*.test.ts",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "jsdom": "^25.0.0",
    "ts-morph": "^24.0.0"
  },
  "devDependencies": {
    "@types/jsdom": "^21.1.7",
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0"
  },
  "engines": {
    "node": ">=20"
  }
}
